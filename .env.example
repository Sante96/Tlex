# ============================================
# TLEX - Telegram Media Server Configuration
# ============================================

# ============================================
# Environment
# ============================================
ENVIRONMENT=prod  # dev | test | prod
# true also serves the API docs at /docs and /openapi.json
DEBUG=false

# ============================================
# Telegram API Credentials
# Get these from https://my.telegram.org/apps
# ============================================
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_USER=tlex
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=tlex_db
# Used only when the backend runs outside Docker (`uv run uvicorn ...`);
# docker-compose points the backend at the postgres container itself.
# The compose file publishes Postgres on 127.0.0.1:5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ============================================
# Redis (rate limits, scheduler and admin settings)
# ============================================
# Outside Docker only, as above
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Security
# ============================================
# REQUIRED (the backend refuses to start without it, 32+ chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# Access tokens are short-lived; the web app renews them with the 30-day refresh token
JWT_EXPIRE_MINUTES=30
# The first account can always register (and becomes admin). After that, sign-ups are
# closed unless this is true or an admin opens them from Settings.
ENABLE_REGISTRATION=false
# Origins allowed to call the API directly (the web app goes through its own proxy)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# TMDB API (for metadata fetching)
# Get from https://www.themoviedb.org/settings/api
# ============================================
TMDB_API_KEY=your_tmdb_api_key
# Default metadata language (the web app sends its UI language per request)
TMDB_LANGUAGE=it-IT

# ============================================
# pgAdmin (http://localhost:5050, desktop mode)
# ============================================
PGADMIN_EMAIL=admin@tlex.local
PGADMIN_PASSWORD=change_this_password

# ============================================
# Scanner Settings
# ============================================
# Comma-separated Telegram channel IDs to scan
SCANNER_CHANNEL_IDS=-1001234567890,-1009876543210
# Topic (thread) ID where movies are uploaded; every other topic is one TV series
# SCANNER_MOVIES_TOPIC_ID=123
# Automatic scan every N hours (0 = off; can also be changed from Settings)
SCANNER_AUTO_INTERVAL_HOURS=0
# Video file extensions to detect
SCANNER_VIDEO_EXTENSIONS=.mkv,.mp4,.avi,.webm
# Split file extensions (for files >4GB)
SCANNER_SPLIT_EXTENSIONS=.001,.002,.003

# ============================================
# Seedbox agent (the Download page)
# ============================================
# The token tools/seedbox_agent.py sends: 32+ chars; empty = the feature is off (its
# endpoints answer 404). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEEDBOX_AGENT_TOKEN=

# ============================================
# Streaming
# ============================================

# ============================================
# Cloudflare named tunnel (only with docker-compose.override.yml)
# ============================================
# The default compose file starts a temporary trycloudflare.com tunnel instead.
TUNNEL_TOKEN=
